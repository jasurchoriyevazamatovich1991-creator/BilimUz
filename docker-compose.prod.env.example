# Variables docker-compose.prod.yml itself interpolates (distinct from
# backend/.env.production, which the BACKEND PROCESS reads — this file
# is read by `docker compose` when it parses docker-compose.prod.yml).
#
# Copy to `.env` in the SAME DIRECTORY you run `docker compose
# -f docker-compose.prod.yml ...` from (normally the repository root —
# Compose auto-loads a file literally named `.env` there). Already
# covered by .gitignore's `.env` rule — never commit the real one.
#
# POSTGRES_PASSWORD must be the SAME password you put in the DATABASE_URL
# inside backend/.env.production (postgresql+psycopg2://postgres:<this
# password>@postgres:5432/bilimuz) — they are two different files
# because one configures the Postgres container itself and the other
# configures the backend process connecting to it, but they must agree.
POSTGRES_PASSWORD=CHANGE_ME_REAL_DB_PASSWORD
