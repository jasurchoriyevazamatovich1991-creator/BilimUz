# Production build-time configuration for the frontend.
#
# Vite bakes VITE_* variables into the built JS at BUILD time — there is
# no runtime env var for a static build. This file is informational /
# for a manual (non-Docker) `npm run build`; the Docker build
# (frontend/Dockerfile) sets the same default via a build ARG, so most
# deployments never need this file at all.
#
# "/api/v1" (a path, no hostname) is correct for the same-origin
# reverse-proxy architecture this deployment uses by default — see
# nginx/nginx.conf and docs/Deployment/PRODUCTION.md. Only change this
# to an absolute URL (https://api.example.com/api/v1) if you have
# deliberately chosen a split-hostname deployment AND have already
# reconfigured the backend's cookie settings for it (SameSite=none,
# REFRESH_TOKEN_COOKIE_DOMAIN, HTTPS) — see backend/README.md's Sprint
# 86 section before doing this.
VITE_API_BASE_URL=/api/v1

# Task 10.1 — show the public registration form (keep in sync with the backend PUBLIC_REGISTRATION_ENABLED)
VITE_PUBLIC_REGISTRATION_ENABLED=false
