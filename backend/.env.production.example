# Production environment template for BilimUz's backend.
#
# Copy to backend/.env.production (gitignored, matches backend/.env's
# existing pattern) and fill in REAL values. Never commit the filled-in
# file. Every variable name below matches backend/app/core/config.py's
# Settings class exactly — none are invented.
#
# This file intentionally contains ONLY placeholder values. Several of
# them (marked below) are the exact literal strings
# validate_production_secrets() in backend/app/core/config.py checks
# for — if any of those literals are still present when
# ENVIRONMENT=production or ENVIRONMENT=staging, the backend refuses to
# start at all (fail-closed, Sprint 73/81). This is deliberate and
# already correct application behavior; do not work around it by
# changing ENVIRONMENT.

APP_NAME=BilimUz
ENVIRONMENT=production
DEBUG=false

# --- Database -----------------------------------------------------------
# docker-compose.prod.yml's postgres service is reachable at hostname
# "postgres" on the internal Docker network only (not published to the
# host) — see that file. Replace POSTGRES_PASSWORD below with a real,
# unique, generated password; it must match what you set for the
# postgres service's own POSTGRES_PASSWORD env var.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME_REAL_DB_PASSWORD@postgres:5432/bilimuz

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- JWT --------------------------------------------------------------
# REQUIRED real value — placeholder below is the exact literal the
# backend refuses to boot with in production/staging. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

VERIFICATION_CODE_TTL_MINUTES=5
VERIFICATION_CODE_MAX_ATTEMPTS=5

# --- Encryption at rest -------------------------------------------------
# REQUIRED real value — same fail-closed check as JWT_SECRET_KEY above.
# If this key is ever lost, every row encrypted with it (settings
# module secrets) becomes permanently unreadable — store it somewhere
# durable (a secrets manager, not just this file on one server).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=CHANGE_ME_IN_PRODUCTION_GENERATE_A_REAL_FERNET_KEY

# --- CORS -----------------------------------------------------------------
# Same-origin deployment (see nginx/nginx.conf): the frontend is served
# from the SAME hostname as the API, so this mainly matters for direct
# API callers other than the bundled frontend (a mobile app, a
# separately-hosted admin tool, etc). Replace with your real domain;
# never use "*" with allow_credentials=True (app/main.py already
# enforces allow_credentials=True — a wildcard origin would be rejected
# by browsers anyway, but don't rely on that).
ALLOWED_ORIGINS=["https://your-real-domain.example"]

# --- Media storage (Sprint 27) --------------------------------------------
# "local" (default) stores uploads on this server's disk — see
# docker-compose.prod.yml's backend_uploads volume. Switch to "r2" only
# if you have a real Cloudflare R2 bucket; the R2_* values below are
# only read (and only checked for unsafe defaults) when
# STORAGE_BACKEND=r2.
STORAGE_BACKEND=local
R2_ACCOUNT_ID=CHANGE_ME_IN_PRODUCTION
R2_ACCESS_KEY_ID=CHANGE_ME_IN_PRODUCTION
R2_SECRET_ACCESS_KEY=CHANGE_ME_IN_PRODUCTION
R2_BUCKET_NAME=CHANGE_ME_IN_PRODUCTION
R2_ENDPOINT=

# --- Refresh-token cookie (Sprint 86) --------------------------------
# Defaults (lax, no domain) are correct for a single production
# hostname serving both frontend and backend (this deployment's
# architecture — see nginx/nginx.conf). Only change these if you
# deliberately deploy frontend and backend on different subdomains of a
# shared registrable domain — read backend/README.md's Sprint 86
# section first; getting this wrong silently breaks login.
# REFRESH_TOKEN_COOKIE_SAMESITE=lax
# REFRESH_TOKEN_COOKIE_DOMAIN=

# --- AI provider (Sprint 88) ----------------------------------------------
# Leave AI_PROVIDER=none to keep the AI Center honestly returning 501
# (no real AI calls, no API costs). Set to "anthropic" + a real
# AI_API_KEY only when you intend to enable it — AI_API_KEY left at the
# placeholder below also still falls back to 501 even if AI_PROVIDER is
# "anthropic" (see app/modules/ai/dependencies.py), but
# validate_production_secrets() will refuse to boot in
# production/staging if AI_PROVIDER=anthropic AND the key is still the
# placeholder — fix one or the other, don't leave it half-configured.
AI_PROVIDER=none
AI_API_KEY=CHANGE_ME_IN_PRODUCTION
AI_MODEL=claude-3-5-haiku-20241022
AI_MAX_OUTPUT_TOKENS=1024
AI_REQUEST_TIMEOUT_SECONDS=30
