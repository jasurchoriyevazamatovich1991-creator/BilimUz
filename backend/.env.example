APP_NAME=BilimUz
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/bilimuz
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

VERIFICATION_CODE_TTL_MINUTES=5
VERIFICATION_CODE_MAX_ATTEMPTS=5

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=change-me-generate-a-real-fernet-key

ALLOWED_ORIGINS=["http://localhost:5173"]

# Sprint 86 — refresh-token cookie. Safe defaults for same-hostname dev
# (frontend:5173 + backend:8000 share a cookie jar — cookies ignore ports).
# Leave both commented out unless your deployment needs a different value;
# see backend/README.md's Sprint 86 section before changing SAMESITE to
# "none" or setting a COOKIE_DOMAIN.
# REFRESH_TOKEN_COOKIE_SAMESITE=lax
# REFRESH_TOKEN_COOKIE_DOMAIN=

# Media storage (Sprint 27). Leave STORAGE_BACKEND=local for
# development — the R2_* values below are only read when it is set to
# "r2". Get these from the Cloudflare dashboard: R2 > Manage R2 API
# Tokens (see docs/Sprint27_R2_Media_Storage.md for the full manual
# setup checklist).
STORAGE_BACKEND=local
R2_ACCOUNT_ID=change-me
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_BUCKET_NAME=change-me
R2_ENDPOINT=

# AI provider (Sprint 88). Leave AI_PROVIDER=none (or unset) for
# development and for automated tests — the AI Center's "send a
# message" endpoint then honestly returns 501 Not Implemented instead
# of calling any real vendor. Set AI_PROVIDER=anthropic AND a real
# AI_API_KEY (get one at https://console.anthropic.com/ — Settings >
# API Keys) to enable real responses; leaving AI_API_KEY at the
# placeholder below with AI_PROVIDER=anthropic also still falls back to
# the honest 501 (see app/modules/ai/README.md). Never commit a real
# key here or anywhere else in this file.
# AI_PROVIDER=none
# AI_API_KEY=change-me
# AI_MODEL=claude-3-5-haiku-20241022
# AI_MAX_OUTPUT_TOKENS=1024
# AI_REQUEST_TIMEOUT_SECONDS=30
