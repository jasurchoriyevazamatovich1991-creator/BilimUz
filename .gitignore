# Backend
__pycache__/
*.pyc
.env
.env.production
.env.production.local
!.env.production.example
venv/
.venv/
.pytest_cache/
.coverage

# Frontend
node_modules/
dist/
.vite/
frontend/.env
frontend/.env.production
frontend/.env.production.local
!frontend/.env.example
!frontend/.env.production.example

# Editor / machine-specific
.vscode/
.idea/
*.swp

# Release/backup archives (GitHub Release Preparation task, Sprint 84+ —
# found multiple untracked pre-commit backup ZIPs at repo root with no
# ignore rule covering them; none were ever tracked, but this prevents a
# careless `git add -A`/`git add .` from accidentally committing one)
*.zip

# Database
database/backups/*
!database/backups/.gitkeep

# Uploads (dev only)
uploads/*
!uploads/*/.gitkeep

# File uploads storage (Sprint 8 — app/modules/uploads/, local disk backend)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

.DS_Store
*.log
